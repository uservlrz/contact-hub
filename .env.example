# Aplicação
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=cole-a-anon-public-key-aqui

# JWT - gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-48-bytes
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Seed (npm run seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@contacthub.local
ADMIN_PASSWORD=Admin@12345
DEMO_OPERATOR_EMAIL=operador@contacthub.local
DEMO_OPERATOR_PASSWORD=Operador@12345
